[Unit]
Description=SciELO Preservation Auditor integrity check
After=local-fs.target

[Service]
Type=oneshot
User=preservation-auditor
Group=preservation-auditor
EnvironmentFile=/etc/preservation-auditor/environment
ExecStart=/opt/preservation-auditor/.venv/bin/preservation-auditor check ${PRESERVATION_AIP_ROOT}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/preservation-auditor /var/log/preservation-auditor
